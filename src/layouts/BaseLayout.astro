---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { serializeJsonLd } from "../lib/json-ld";
import { markdownPublicPath } from "../lib/markdown-path";
import { siteConfig } from "../data/site";

interface Props {
  title: string;
  metaTitle: string;
  description: string;
  canonicalPath: string;
  dateModified: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  schema?: Record<string, unknown>[];
  noindex?: boolean;
}

const {
  title,
  metaTitle,
  description,
  canonicalPath,
  dateModified,
  ogImage,
  ogImageAlt,
  ogImageWidth,
  ogImageHeight,
  schema = [],
  noindex = false,
} = Astro.props;

const site = Astro.site ?? new URL("https://portugalhqacitizenship.com");
const websiteId = "https://portugalhqacitizenship.com/#website";

function absoluteUrl(value: string): string {
  if (value.startsWith("http://") || value.startsWith("https://")) {
    return value;
  }
  return new URL(value, site).href;
}

const canonical = absoluteUrl(canonicalPath);
const markdownHref = absoluteUrl(markdownPublicPath(canonicalPath));
const image = ogImage ? absoluteUrl(ogImage) : undefined;

function nodeUrl(entry: Record<string, unknown>): string {
  return typeof entry.url === "string" ? entry.url : canonical;
}

const graph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": websiteId,
      name: siteConfig.siteName,
      url: "https://portugalhqacitizenship.com/",
    },
    ...schema.map((entry) => {
      const type = entry["@type"];
      const dated =
        type === "WebPage" || type === "Article" || type === "NewsArticle" || type === "CollectionPage"
          ? { ...entry, dateModified }
          : entry;
      const pageUrl = nodeUrl(dated);
      const webpageId = new URL("#webpage", pageUrl).href;
      if (type === "WebPage") {
        return {
          ...dated,
          "@id": webpageId,
          isPartOf: { "@id": websiteId },
          inLanguage: "en",
        };
      }
      if (type === "Article" || type === "NewsArticle") {
        return {
          ...dated,
          "@id": new URL(type === "NewsArticle" ? "#newsarticle" : "#article", pageUrl).href,
          url: pageUrl,
          mainEntityOfPage: { "@id": webpageId },
          isPartOf: { "@id": websiteId },
          inLanguage: "en",
        };
      }
      if (type === "CollectionPage") {
        return {
          ...dated,
          "@id": new URL("#collection", pageUrl).href,
          isPartOf: { "@id": websiteId },
          inLanguage: "en",
        };
      }
      return dated;
    }),
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{metaTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {!noindex && <link rel="alternate" type="text/markdown" href={markdownHref} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteConfig.siteName} />
    <meta property="og:locale" content="en_US" />
    {
      image && (
        <>
          <meta property="og:image" content={image} />
          {ogImageWidth && <meta property="og:image:width" content={String(ogImageWidth)} />}
          {ogImageHeight && <meta property="og:image:height" content={String(ogImageHeight)} />}
          {ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}
        </>
      )
    }
    <meta name="twitter:card" content={image ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {image && <meta name="twitter:image" content={image} />}
    <script type="application/ld+json" set:html={serializeJsonLd(graph)} />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
