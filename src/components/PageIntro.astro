---
import LastVerified from "./LastVerified.astro";

interface Props {
  title: string;
  verified?: string;
  path?: string;
}

const { title, verified, path } = Astro.props;
---

<section class="page-intro">
  <div class="container">
    <div class="measure">
      {
        Astro.slots.has("crumbs") && (
          <div class="crumbs-wrap">
            <slot name="crumbs" />
          </div>
        )
      }
      <h1>{title}</h1>
      <slot name="lead" />
      {
        Astro.slots.has("actions") && (
          <div class="actions">
            <slot name="actions" />
          </div>
        )
      }
      {
        (verified && path) || Astro.slots.has("disclaimer") ? (
          <div class="hero-note">
            {verified && path && <LastVerified verified={verified} path={path} />}
            <slot name="disclaimer" />
          </div>
        ) : null
      }
    </div>
  </div>
</section>

<style>
  .page-intro {
    padding-top: var(--space-block);
    text-align: left;
  }

  .crumbs-wrap {
    margin-bottom: 1.25rem;
  }

  .page-intro h1,
  .page-intro :global(.lead) {
    margin: 0;
  }

  .page-intro :global(.lead),
  .actions {
    margin-top: 1.25rem;
  }

  .actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.25rem;
  }

  .hero-note {
    margin-top: 24px;
  }

  @media (max-width: 767px) {
    .actions :global(.solid) {
      width: 100%;
      justify-content: center;
    }
  }

  @media (min-width: 768px) {
    .actions {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.5rem 1.5rem;
    }
  }
</style>
