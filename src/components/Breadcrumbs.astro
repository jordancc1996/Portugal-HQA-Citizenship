---
import { serializeJsonLd } from "../lib/json-ld";

interface Crumb {
  name: string;
  href: string;
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;
const site = Astro.site ?? new URL("https://portugalhqacitizenship.com");

const schema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: items.map((item, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: item.name,
    item: new URL(item.href, site).href,
  })),
};
---

<nav class="crumbs" aria-label="Breadcrumb">
  <ol>
    {
      items.map((item, index) => (
        <li>
          {index < items.length - 1 ? (
            <a href={item.href}>{item.name}</a>
          ) : (
            <span aria-current="page">{item.name}</span>
          )}
        </li>
      ))
    }
  </ol>
</nav>
<script type="application/ld+json" set:html={serializeJsonLd(schema)} />

<style>
  ol {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.5rem;
    margin: 0;
    padding: 0;
    color: var(--color-graphite);
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 400;
    line-height: 1.5;
  }

  li {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  li:not(:last-child)::after {
    content: "/";
    color: var(--color-graphite);
  }

  a,
  span {
    color: var(--color-graphite);
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 0;
  }
</style>
