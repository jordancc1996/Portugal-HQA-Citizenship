---
import { formatVerifiedDate } from "../lib/format-date";

interface Item {
  href: string;
  title: string;
  summary: string;
  published: string;
  verified?: string;
}

interface Props {
  items: Item[];
  dateFirst?: boolean;
}

const { items, dateFirst = false } = Astro.props;
---

<ul class="publications">
  {
    items.map((item) => (
      <li>
        <a href={item.href}>{item.title}</a>
        {dateFirst ? <p class="small">Published: {formatVerifiedDate(item.published)}</p> : <p>{item.summary}</p>}
        {dateFirst ? <p>{item.summary}</p> : <p class="small">Published: {formatVerifiedDate(item.published)}</p>}
        {item.verified ? <p class="small">Last verified: {formatVerifiedDate(item.verified)}</p> : null}
      </li>
    ))
  }
</ul>

<style>
  .publications {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  li {
    border-top: 1px solid var(--color-rule);
    padding: 1.25rem 0;
    background: none;
  }

  li:last-child {
    border-bottom: 1px solid var(--color-rule);
  }

  a {
    font-family: var(--font-serif);
    font-size: 21px;
    font-weight: 500;
    line-height: 1.3;
  }

  p {
    margin: 0.4rem 0 0;
  }
</style>
