---
import Section from "./Section.astro";

interface Props {
  heading: string;
  paragraph: string;
}

const { heading, paragraph } = Astro.props;
---

<Section tone="atlantic" class="band">
  <div class="measure">
    <h2>{heading}</h2>
    <p>{paragraph}</p>
    <div class="slot">
      <slot />
    </div>
  </div>
</Section>

<style>
  h2 {
    margin-bottom: 1rem;
  }

  p {
    margin: 0;
  }

  .slot {
    margin-top: 1.5rem;
  }
</style>
