---
interface Props {
  href?: string;
  variant?: "solid" | "text";
  type?: "button" | "submit" | "reset";
}

const { href, variant = "solid", type = "button" } = Astro.props;
const className = variant === "text" ? "text-link" : "solid";
---

{
  href ? (
    <a href={href} class={className}>
      <slot />
    </a>
  ) : (
    <button type={type} class={className}>
      <slot />
    </button>
  )
}

<style>
  .solid {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    height: 48px;
    padding: 0 1.25rem;
    border: 1px solid var(--color-atlantic);
    border-radius: 4px;
    background: var(--color-atlantic);
    box-shadow: none;
    color: #ffffff;
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 500;
    letter-spacing: 0.02em;
    line-height: 1;
    text-decoration: none;
    cursor: pointer;
    transition: background-color 150ms ease-out, color 150ms ease-out;
  }

  .solid:hover {
    background: #ffffff;
    color: var(--color-atlantic);
  }

  .solid:focus-visible {
    outline: 2px solid var(--color-atlantic);
    outline-offset: 3px;
  }

  .solid:disabled,
  .solid:disabled:hover {
    background: var(--color-graphite);
    border-color: var(--color-graphite);
    color: #ffffff;
    cursor: wait;
  }

  .text-link {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: 0;
    border: 0;
    background: none;
    box-shadow: none;
    color: var(--color-atlantic);
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 500;
    letter-spacing: 0.02em;
    line-height: 1.3;
    text-decoration-line: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    cursor: pointer;
  }
</style>
