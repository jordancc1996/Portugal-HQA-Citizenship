---
import { formatVerifiedDate } from "../lib/format-date";

interface Guide {
  href: string;
  title: string;
  summary?: string;
  verified?: string;
}

interface Props {
  guides: Guide[];
}

const { guides } = Astro.props;
---

<ul class="guides">
  {
    guides.map((guide) => (
      <li>
        <a href={guide.href}>{guide.title}</a>
        {guide.summary ? <p>{guide.summary}</p> : null}
        {guide.verified ? <p class="small">Last verified: {formatVerifiedDate(guide.verified)}</p> : null}
      </li>
    ))
  }
</ul>

<style>
  .guides {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  li {
    border-top: 1px solid var(--color-rule);
    padding: 1.25rem 0;
    background: none;
  }

  li:last-child {
    border-bottom: 1px solid var(--color-rule);
  }

  a {
    font-family: var(--font-serif);
    font-size: 21px;
    font-weight: 500;
    line-height: 1.3;
  }

  p {
    margin: 0.4rem 0 0;
  }
</style>
