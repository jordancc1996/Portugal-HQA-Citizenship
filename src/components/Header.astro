---
import Logo from "./Logo.astro";
import { menuLinks, reportsReady } from "../data/menu";
import { siteConfig } from "../data/site";

const current = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<header class="site-header">
  <div class="container bar">
    <a class="wordmark" href="/" aria-label="Portugal HQA Citizenship, home">
      <Logo />
    </a>
    <details class="menu">
      <summary>
        <span class="icon" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </span>
        <span class="labels">
          <span class="label-closed">Menu</span>
          <span class="label-open">Close</span>
        </span>
      </summary>
      <div class="panel">
        <div class="container panel-body">
          <nav aria-label="Primary">
            <ul class="links">
              {
                menuLinks.map((link) => (
                  <li>
                    <a href={link.href} aria-current={current === link.href ? "page" : undefined}>
                      {link.label}
                    </a>
                  </li>
                ))
              }
            </ul>
            <div class="actions">
              <a
                class="consult"
                href="/consultation"
                aria-current={current === "/consultation" ? "page" : undefined}
              >
                Request a consultation
              </a>
              {
                reportsReady && (
                  <a class="reports-link" href="/reports">
                    Read our reports
                    <svg class="arrow" viewBox="0 0 16 16" width="18" height="18" aria-hidden="true" focusable="false">
                      <path d="M3 13 L13 3 M13 3 H6.5 M13 3 V9.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" />
                    </svg>
                  </a>
                )
              }
            </div>
          </nav>
          <p class="menu-mail">
            <a href={`mailto:${siteConfig.contactEmail}`}>{siteConfig.contactEmail}</a>
          </p>
        </div>
      </div>
    </details>
  </div>
</header>

<script>
  const menu = document.querySelector(".site-header .menu");
  const wordmark = document.querySelector(".site-header .wordmark");

  function setLocked(open: boolean) {
    document.documentElement.classList.toggle("menu-open", open);
  }

  function focusables() {
    if (!(menu instanceof HTMLDetailsElement)) return [];
    return [...menu.querySelectorAll("summary, a[href]")].filter(
      (node) => node instanceof HTMLElement,
    );
  }

  if (menu instanceof HTMLDetailsElement) {
    menu.addEventListener("toggle", () => {
      setLocked(menu.open);
      if (wordmark instanceof HTMLAnchorElement) {
        if (menu.open) wordmark.setAttribute("tabindex", "-1");
        else wordmark.removeAttribute("tabindex");
      }
      if (!menu.open) return;
      const firstLink = menu.querySelector(".links a");
      if (firstLink instanceof HTMLElement) firstLink.focus({ preventScroll: true });
    });
  }

  document.addEventListener("keydown", (event) => {
    if (!(menu instanceof HTMLDetailsElement) || !menu.open) return;

    if (event.key === "Escape") {
      menu.open = false;
      const summary = menu.querySelector("summary");
      if (summary instanceof HTMLElement) summary.focus();
      return;
    }

    if (event.key !== "Tab") return;
    const items = focusables();
    if (items.length === 0) return;
    const first = items[0];
    const last = items[items.length - 1];
    const active = document.activeElement;

    if (event.shiftKey && active === first) {
      event.preventDefault();
      last.focus();
    } else if (!event.shiftKey && active === last) {
      event.preventDefault();
      first.focus();
    }
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--color-paper);
    border-bottom: 1px solid var(--color-rule);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    height: 64px;
  }

  .wordmark {
    display: flex;
    align-items: center;
    min-width: 0;
    color: var(--color-atlantic);
    font-size: 21px;
    line-height: 1;
    text-decoration: none;
  }

  .wordmark:hover {
    color: var(--color-atlantic);
    text-decoration: none;
  }

  .menu {
    flex: none;
  }

  summary {
    display: inline-flex;
    align-items: center;
    justify-content: flex-end;
    gap: 10px;
    box-sizing: border-box;
    min-width: 48px;
    min-height: 48px;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-ink);
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 500;
    line-height: 1.2;
    list-style: none;
    cursor: pointer;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .icon {
    position: relative;
    display: block;
    width: 28px;
    height: 20px;
    flex: none;
  }

  .icon span {
    position: absolute;
    left: 0;
    width: 28px;
    height: 2px;
    background: var(--color-ink);
  }

  .icon span:nth-child(1) {
    top: 0;
  }

  .icon span:nth-child(2) {
    top: 9px;
  }

  .icon span:nth-child(3) {
    top: 18px;
  }

  details[open] .icon span:nth-child(1) {
    top: 9px;
    transform: rotate(45deg);
  }

  details[open] .icon span:nth-child(2) {
    opacity: 0;
  }

  details[open] .icon span:nth-child(3) {
    top: 9px;
    transform: rotate(-45deg);
  }

  .labels {
    display: inline-grid;
  }

  .label-closed,
  .label-open {
    grid-area: 1 / 1;
  }

  .label-open {
    visibility: hidden;
  }

  details[open] .label-closed {
    visibility: hidden;
  }

  details[open] .label-open {
    visibility: visible;
  }

  .panel {
    position: fixed;
    top: 65px;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 1;
    overflow: auto;
    background: var(--color-cream);
    animation: menu-in 150ms ease-out;
  }

  .panel-body {
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
    min-height: calc(100dvh - 65px);
    padding-top: 32px;
    padding-bottom: 32px;
  }

  .links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
  }

  .links a {
    display: inline-flex;
    align-items: center;
    box-sizing: border-box;
    min-height: 48px;
    color: var(--color-ink);
    font-family: var(--font-serif);
    font-size: 34px;
    font-weight: 400;
    line-height: 1.1;
    text-decoration: none;
    white-space: nowrap;
  }

  .links a:hover,
  .links a:focus,
  .links a[aria-current="page"] {
    color: var(--color-atlantic);
    text-decoration-line: underline;
    text-decoration-color: var(--color-atlantic);
    text-decoration-thickness: 2px;
    text-underline-offset: 6px;
  }

  .actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    margin-top: 40px;
  }

  .consult,
  .reports-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    box-sizing: border-box;
    height: 60px;
    padding: 0 32px;
    border: 1px solid var(--color-atlantic);
    border-radius: 4px;
    font-family: var(--font-sans);
    font-size: 18px;
    font-weight: 500;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
  }

  .consult {
    background: var(--color-atlantic);
    color: #ffffff;
  }

  .consult:hover,
  .consult:focus {
    background: var(--color-atlantic);
    color: #ffffff;
    text-decoration: none;
  }

  .reports-link {
    background: transparent;
    color: var(--color-atlantic);
  }

  .reports-link:hover,
  .reports-link:focus {
    color: var(--color-atlantic);
    text-decoration: none;
  }

  .arrow {
    display: block;
    flex: none;
  }

  .menu-mail {
    margin: 24px 0 0;
    color: var(--color-graphite);
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 400;
    line-height: 1.5;
  }

  .menu-mail a {
    display: inline-flex;
    align-items: center;
    box-sizing: border-box;
    min-height: 48px;
    color: var(--color-graphite);
    font-family: inherit;
    font-size: inherit;
    font-weight: inherit;
    text-decoration-line: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  @media (min-width: 768px) {
    .bar {
      height: 80px;
    }

    .wordmark {
      font-size: 26px;
    }

    .panel {
      top: 81px;
    }

    .panel-body {
      min-height: calc(100dvh - 81px);
    }

    .links a {
      font-size: 44px;
    }

    .actions {
      flex-direction: row;
      align-items: center;
    }
  }

  @media (min-width: 1024px) {
    .links a {
      font-size: 56px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .panel {
      animation: none;
    }
  }

  @keyframes menu-in {
    from {
      opacity: 0;
    }

    to {
      opacity: 1;
    }
  }

  :global(html.menu-open),
  :global(html.menu-open body) {
    overflow: hidden;
  }

  :global(html.menu-open) .site-header {
    background: var(--color-cream);
    border-bottom-color: var(--color-cream);
  }
</style>
