---
import Logo from "./Logo.astro";
import { siteConfig } from "../data/site";

const links = [
  { href: "/portugal-hqa-visa-investment", label: "Investment" },
  { href: "/hqa-visa-cost", label: "Costs" },
  { href: "/hqa-visa-requirements", label: "Requirements" },
  { href: "/guides/hqa-visa-citizenship-10-year-rule", label: "Citizenship" },
  { href: "/guides", label: "Guides" },
  { href: "/about", label: "About" },
  { href: "/consultation", label: "Request a consultation", consult: true },
];

const pageLinks = links.filter((link) => !link.consult);
const consult = links.find((link) => link.consult);
const current = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<header class="site-header">
  <div class="container bar">
    <a class="wordmark" href="/" aria-label="Portugal HQA Citizenship, home">
      <Logo />
    </a>
    <details class="menu">
      <summary>
        <span class="icon" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </span>
        <span class="labels">
          <span class="label-closed">Menu</span>
          <span class="label-open">Close</span>
        </span>
      </summary>
      <div class="panel">
        <div class="container panel-body">
          <nav aria-label="Primary">
            <ul class="links">
              {
                pageLinks.map((link) => (
                  <li>
                    <a href={link.href} aria-current={current === link.href ? "page" : undefined}>
                      {link.label}
                    </a>
                  </li>
                ))
              }
            </ul>
            {
              consult && (
                <p class="consult-wrap">
                  <a
                    class="consult"
                    href={consult.href}
                    aria-current={current === consult.href ? "page" : undefined}
                  >
                    {consult.label}
                  </a>
                </p>
              )
            }
          </nav>
          <p class="menu-mail">
            <a href={`mailto:${siteConfig.contactEmail}`}>{siteConfig.contactEmail}</a>
          </p>
        </div>
      </div>
    </details>
  </div>
</header>

<script>
  const menu = document.querySelector(".site-header .menu");
  const wordmark = document.querySelector(".site-header .wordmark");

  function setLocked(open: boolean) {
    document.documentElement.classList.toggle("menu-open", open);
  }

  function focusables() {
    if (!(menu instanceof HTMLDetailsElement)) return [];
    return [...menu.querySelectorAll("summary, a[href]")].filter(
      (node) => node instanceof HTMLElement,
    );
  }

  if (menu instanceof HTMLDetailsElement) {
    menu.addEventListener("toggle", () => {
      setLocked(menu.open);
      if (wordmark instanceof HTMLAnchorElement) {
        if (menu.open) wordmark.setAttribute("tabindex", "-1");
        else wordmark.removeAttribute("tabindex");
      }
      if (!menu.open) return;
      const firstLink = menu.querySelector(".links a");
      if (firstLink instanceof HTMLElement) firstLink.focus({ preventScroll: true });
    });
  }

  document.addEventListener("keydown", (event) => {
    if (!(menu instanceof HTMLDetailsElement) || !menu.open) return;

    if (event.key === "Escape") {
      menu.open = false;
      const summary = menu.querySelector("summary");
      if (summary instanceof HTMLElement) summary.focus();
      return;
    }

    if (event.key !== "Tab") return;
    const items = focusables();
    if (items.length === 0) return;
    const first = items[0];
    const last = items[items.length - 1];
    const active = document.activeElement;

    if (event.shiftKey && active === first) {
      event.preventDefault();
      last.focus();
    } else if (!event.shiftKey && active === last) {
      event.preventDefault();
      first.focus();
    }
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--color-paper);
    border-bottom: 1px solid var(--color-rule);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    height: 64px;
  }

  .wordmark {
    display: flex;
    align-items: center;
    min-width: 0;
    color: var(--color-atlantic);
    font-size: 21px;
    line-height: 1;
    text-decoration: none;
  }

  .wordmark:hover {
    color: var(--color-atlantic);
    text-decoration: none;
  }

  .menu {
    flex: none;
  }

  summary {
    display: inline-flex;
    align-items: center;
    justify-content: flex-end;
    gap: 10px;
    box-sizing: border-box;
    min-width: 48px;
    min-height: 48px;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-ink);
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 500;
    line-height: 1.2;
    list-style: none;
    cursor: pointer;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .icon {
    position: relative;
    display: block;
    width: 28px;
    height: 20px;
    flex: none;
  }

  .icon span {
    position: absolute;
    left: 0;
    width: 28px;
    height: 2px;
    background: var(--color-ink);
  }

  .icon span:nth-child(1) {
    top: 0;
  }

  .icon span:nth-child(2) {
    top: 9px;
  }

  .icon span:nth-child(3) {
    top: 18px;
  }

  details[open] .icon span:nth-child(1) {
    top: 9px;
    transform: rotate(45deg);
  }

  details[open] .icon span:nth-child(2) {
    opacity: 0;
  }

  details[open] .icon span:nth-child(3) {
    top: 9px;
    transform: rotate(-45deg);
  }

  .labels {
    display: inline-grid;
  }

  .label-closed,
  .label-open {
    grid-area: 1 / 1;
  }

  .label-open {
    visibility: hidden;
  }

  details[open] .label-closed {
    visibility: hidden;
  }

  details[open] .label-open {
    visibility: visible;
  }

  .panel {
    position: fixed;
    top: 65px;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 1;
    overflow: auto;
    background: var(--color-paper);
    animation: menu-in 150ms ease-out;
  }

  .panel-body {
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
    min-height: calc(100dvh - 65px);
    padding-top: 32px;
    padding-bottom: 32px;
  }

  .links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
  }

  .links a {
    color: var(--color-ink);
    font-family: var(--font-serif);
    font-size: 28px;
    font-weight: 400;
    line-height: 1.2;
    text-decoration: none;
  }

  .links a:hover,
  .links a:focus-visible {
    text-decoration-line: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .links a[aria-current="page"] {
    text-decoration-line: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .consult-wrap {
    margin: 32px 0 0;
    padding-top: 32px;
    border-top: 1px solid var(--color-rule);
  }

  .consult {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    height: 48px;
    padding: 0 1.25rem;
    border: 1px solid var(--color-atlantic);
    border-radius: 4px;
    background: var(--color-atlantic);
    box-shadow: none;
    color: #ffffff;
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 500;
    letter-spacing: 0.02em;
    line-height: 1;
    text-decoration: none;
  }

  .consult:hover {
    background: #ffffff;
    color: var(--color-atlantic);
    text-decoration: none;
  }

  .menu-mail {
    margin: auto 0 0;
    padding-top: 32px;
    color: var(--color-graphite);
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 400;
    line-height: 1.5;
  }

  .menu-mail a {
    color: var(--color-graphite);
    font-family: inherit;
    font-size: inherit;
    font-weight: inherit;
    text-decoration-line: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  @media (min-width: 768px) {
    .bar {
      height: 80px;
    }

    .wordmark {
      font-size: 26px;
    }

    .panel {
      top: 81px;
    }

    .panel-body {
      min-height: calc(100dvh - 81px);
    }

    .links a {
      font-size: 36px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .panel {
      animation: none;
    }
  }

  @keyframes menu-in {
    from {
      opacity: 0;
    }

    to {
      opacity: 1;
    }
  }

  :global(html.menu-open),
  :global(html.menu-open body) {
    overflow: hidden;
  }
</style>
