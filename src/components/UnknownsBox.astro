---
interface Props {
  level?: 2 | 3;
}

const { level = 3 } = Astro.props;
const Tag = level === 2 ? "h2" : "h3";
---

<aside class="unknowns">
  <Tag class="unknowns-title">What we don't know yet</Tag>
  <div class="unknowns-body">
    <slot />
  </div>
</aside>

<style>
  .unknowns {
    background: var(--unknowns-bg, var(--color-cream));
    border: 0;
    border-left: 2px solid var(--color-atlantic);
    border-radius: 0;
    box-shadow: none;
    padding: 1.5rem 1.5rem 1.5rem 1.25rem;
  }

  .unknowns-title {
    margin-bottom: 0.75rem;
  }

  .unknowns-body :global(p) {
    margin: 0 0 0.75rem;
  }

  .unknowns-body :global(p:last-child) {
    margin-bottom: 0;
  }
</style>
