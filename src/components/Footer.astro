---
import Logo from "./Logo.astro";
import { isNoindex } from "../data/reviews";
import { siteConfig } from "../data/site";

const links = [
  { href: "/methodology", label: "Methodology" },
  { href: "/hqa-visa-status", label: "Status updates" },
  { href: "/reports", label: "Reports" },
  { href: "/press", label: "Press" },
  { href: "/image-credits", label: "Image credits" },
  { href: "/privacy", label: "Privacy" },
  { href: "/terms", label: "Terms" },
  { href: "/contact", label: "Contact" },
].filter((link) => (link.href !== "/reports" && link.href !== "/press") || !isNoindex(link.href));
---

<footer class="site-footer">
  <div class="container inner">
    <p class="footer-logo">
      <Logo tone="white" />
    </p>
    <p>
      {siteConfig.siteName} is an independent information site.
    </p>
    <p>
      This site gives general information, not legal, tax or investment advice. Rules change. Speak
      to a qualified Portuguese lawyer before you commit money.
    </p>
    <nav aria-label="Footer">
      <ul>
        {
          links.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
        <li>
          <a href={`mailto:${siteConfig.privacyEmail}`}>{siteConfig.privacyEmail}</a>
        </li>
      </ul>
    </nav>
    <p class="copyright">© 2026 {siteConfig.siteName}</p>
  </div>
</footer>

<style>
  .site-footer {
    background: #141414;
    color: #ffffff;
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 400;
    letter-spacing: 0;
    line-height: 1.6;
    padding-block: 64px;
  }

  .inner {
    padding-block: 0;
    display: grid;
    gap: 1.25rem;
  }

  p {
    margin: 0;
  }

  .footer-logo {
    margin: 0;
    font-size: 17px;
    line-height: 1;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
  }

  a {
    color: #ffffff;
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 400;
    letter-spacing: 0;
    text-decoration-line: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .copyright {
    color: #b8b2a8;
  }

  @media (min-width: 768px) {
    .site-footer {
      padding-block: 112px;
    }

    .footer-logo {
      font-size: 21px;
    }
  }
</style>
