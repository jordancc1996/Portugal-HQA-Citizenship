---
import type { ImageMetadata } from "astro";
import Photo from "./Photo.astro";
import Section from "./Section.astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
}

const { src, alt, caption } = Astro.props;
---

<Section tone="paper" class="photo-break">
  <div class="wide">
    <div class="frame">
      <Photo
        src={src}
        alt={alt}
        quality={80}
        maxWidth={1600}
        sizes="(min-width: 1024px) 1104px, 100vw"
      />
    </div>
    {caption && <p class="caption">{caption}</p>}
  </div>
</Section>

<style>
  .frame {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--color-cream);
  }

  .frame :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
  }

  .caption {
    margin: 0.75rem 0 0;
    color: var(--color-graphite);
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 0;
    line-height: 1.5;
  }

  @media (min-width: 1024px) {
    .frame {
      aspect-ratio: 21 / 9;
    }
  }
</style>
