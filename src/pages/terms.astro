---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageIntro from "../components/PageIntro.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { getImage } from "astro:assets";
import { siteConfig } from "../data/site";
import { verifiedOn } from "../data/pages";
import { isNoindex } from "../data/reviews";
import defaultHero from "../assets/images/lisbon-alfama-rooftops.webp";
import Section from "../components/Section.astro";

const description =
  "Terms of use for portugalhqacitizenship.com: general information only, no legal or investment advice, no guarantees, and how introductions to advisors work.";

const headline = "Terms of Use";
const lead = "By using portugalhqacitizenship.com you agree to these terms. Last updated: 21 October 2026.";
const pageUrl = "https://portugalhqacitizenship.com/terms";
const ogAlt = "Rooftops of Alfama in Lisbon with São Vicente de Fora church on the skyline";
const mailto = `mailto:${siteConfig.contactEmail}`;
const lastVerified = verifiedOn("/terms");

const ogImage = await getImage({
  src: defaultHero,
  width: 1200,
  height: 630,
  fit: "cover",
  format: "jpg",
  quality: 82,
  layout: "none",
});
---

<BaseLayout
  title="Terms of Use"
  metaTitle="Terms of Use | Portugal HQA Citizenship"
  description={description}
  canonicalPath="/terms"
  dateModified={lastVerified}
  noindex={isNoindex("/terms")}
  ogImage={ogImage.src}
  ogImageAlt={ogAlt}
  ogImageWidth={Number(ogImage.attributes.width ?? 1200)}
  ogImageHeight={Number(ogImage.attributes.height ?? 630)}
  schema={[
    {
      "@type": "WebPage",
      name: headline,
      description: lead,
      url: pageUrl,
    },
  ]}
>
  <PageIntro
  title={headline}
>
  <Breadcrumbs slot="crumbs"
    items={[
        { name: "Home", href: "/" },
        { name: "Terms", href: "/terms" },
      ]}
  />
  <p class="lead" slot="lead">{lead}</p>
</PageIntro>

  <div class="reading end">
    <Section tone="cream">
<div class="measure">
      <h2>General information only</h2>
      <p>This site gives general information about Portuguese residence and citizenship rules. It is not legal, tax or investment advice, and it does not create a client relationship. Speak to a qualified professional before you act.</p>
    </div>
</Section>

    <Section tone="paper">
<div class="measure">
      <h2>No guarantees</h2>
      <p>Rules change, and we cannot promise that every page is complete or current. We do not guarantee any visa, permit, citizenship outcome, timeline or investment return.</p>
    </div>
</Section>

    <Section tone="cream">
<div class="measure">
      <h2>Introductions</h2>
      <p>If you ask us to, we may introduce you to advisors or providers. We are not responsible for their services. Any agreement is between you and them. Check every advisor or provider yourself before you sign or pay.</p>
    </div>
</Section>

    <Section tone="paper">
<div class="measure">
      <h2>Not affiliated</h2>
      <p>We are not connected to the Portuguese government, AIMA, IAPMEI or any provider. "HQA" is used here as a plain description of highly qualified activity, not as a brand.</p>
    </div>
</Section>

    <Section tone="cream">
<div class="measure">
      <h2>Content and links</h2>
      <p>You may share links to our pages. Do not copy large parts of the site without permission. Links to other websites are for information; we are not responsible for their content.</p>
    </div>
</Section>

    <Section tone="paper">
<div class="measure">
      <h2>Photos</h2>
      <p>Photos are used under the Unsplash License. See <a href="/image-credits">image credits</a>.</p>
    </div>
</Section>

    <Section tone="cream">
<div class="measure">
      <h2>Contact</h2>
      <p>{siteConfig.siteName}</p>
      <p><a href={mailto}>{siteConfig.contactEmail}</a></p>
      <p>Privacy questions: <a href={`mailto:${siteConfig.privacyEmail}`}>{siteConfig.privacyEmail}</a></p>
    </div>
</Section>
  </div>
</BaseLayout>
