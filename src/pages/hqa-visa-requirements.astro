---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import PageHero from "../components/PageHero.astro";
import Button from "../components/Button.astro";
import KeyFacts from "../components/KeyFacts.astro";
import Table from "../components/Table.astro";
import UnknownsBox from "../components/UnknownsBox.astro";
import LeadMagnetBand from "../components/LeadMagnetBand.astro";
import ChecklistForm from "../components/ChecklistForm.astro";
import FAQ from "../components/FAQ.astro";
import { getImage } from "astro:assets";
import { verifiedOn } from "../data/pages";
import hero from "../assets/images/blue-white-tile-pattern.webp";
import Section from "../components/Section.astro";

const lastVerified = verifiedOn("/hqa-visa-requirements");

const description =
  "HQA visa Portugal requirements in 2026: what the law asks for under articles 61 and 90, what providers add on top, the documents you need and open questions.";

const heroAlt = "Blue and white decorative tile pattern";
const headline = "HQA Visa Portugal Requirements: Who Qualifies";
const pageUrl = "https://portugalhqacitizenship.com/hqa-visa-requirements";

const ogImage = await getImage({
  src: hero,
  width: 1200,
  height: 630,
  fit: "cover",
  format: "jpg",
  quality: 82,
  layout: "none",
});

const faqItems = [
  {
    question: "Do I need a degree for the HQA visa?",
    answer:
      "In practice, yes. Highly qualified activity means work that needs specialised skills or a matching qualification, and most packages ask for a degree.",
  },
  {
    question: "Do I need a PhD?",
    answer:
      "Not under the general rules we have reviewed. A PhD can help, and some research projects may ask for one.",
  },
  {
    question: "Is there a minimum investment requirement?",
    answer: "No. Portuguese law sets no investment amount for this route. The investment is a provider's price.",
  },
  {
    question: "Can two co-founders use one package?",
    answer: "It depends on the provider. Some packages accept only one founder. Ask before you pay.",
  },
  {
    question: "Do I need to speak Portuguese?",
    answer:
      "Not for the visa or the first permit. Basic Portuguese is required for permanent residence, and a language test is required for citizenship.",
  },
];
---

<BaseLayout
  title="HQA Visa Portugal Requirements - Who Qualifies"
  metaTitle="HQA Visa Portugal Requirements - Who Qualifies | Portugal HQA Citizenship"
  description={description}
  canonicalPath="/hqa-visa-requirements"
  dateModified={lastVerified}
  ogImage={ogImage.src}
  ogImageAlt={heroAlt}
  ogImageWidth={Number(ogImage.attributes.width ?? 1200)}
  ogImageHeight={Number(ogImage.attributes.height ?? 630)}
  schema={[
    {
      "@type": "WebPage",
      name: headline,
      description:
        "HQA visa Portugal requirements come from two places: Portuguese law, and the provider selling you the investment package. The law sets the conditions for the visa and the residence permit. Providers add their own entry rules for their packages. This page separates the two, so you know which rules you cannot change and which ones you can negotiate.",
      url: pageUrl,
    },
    {
      "@type": "Article",
      headline,
      dateModified: lastVerified,
    },
  ]}
>
  <PageHero
    title={headline}
    photo={hero}
    photoAlt={heroAlt}
    verified={lastVerified}
    path="/hqa-visa-requirements"
    maxWidth={720}
    quality={45}
    priority
    smallAspect="4/5"
  >
    <Breadcrumbs
      slot="crumbs"
      items={[
        { name: "Home", href: "/" },
        { name: "HQA visa requirements", href: "/hqa-visa-requirements" },
      ]}
    />
    <p class="lead" slot="lead">
      HQA visa Portugal requirements come from two places: Portuguese law, and the provider selling you the investment package. The law sets the conditions for the visa and the residence permit. Providers add their own entry rules for their packages. This page separates the two, so you know which rules you cannot change and which ones you can negotiate.
    </p>
    <p class="small disclaimer" slot="disclaimer">This page is general information, not legal, tax or investment advice.</p>
  </PageHero>

  <Section tone="cream" as="div">
<div class="wide">
    <KeyFacts
      items={[
        {
          lead: "The legal basis is Lei 23/2007.",
          text: "Article 61 covers the D3 residence visa. Article 90 covers the residence permit for highly qualified activity.",
        },
        {
          lead: "There is no investment requirement in law.",
          text: "The investment is how a package creates the qualifying activity.",
        },
        {
          lead: "Qualifications matter.",
          text: "Highly qualified activity means work that needs specialised technical skills or a matching qualification.",
        },
        {
          lead: "Absence limits apply.",
          text: "A temporary permit may be cancelled after more than 6 consecutive months, or 8 non-consecutive months, outside Portugal during its validity, unless the absence is justified.",
        },
      ]}
    />
</div>
</Section>

  <div class="reading">
    <Section tone="paper">
<div class="measure">
      <h2>What the law requires</h2>
      <p>To get a residence permit for highly qualified activity under article 90, you need one of these:</p>
      <ul>
        <li>An employment or service contract for highly qualified work</li>
        <li>An invitation from a teaching or vocational-training institution</li>
        <li>A statement of responsibility from a company certified for the Tech Visa</li>
        <li>A cultural activity recognised as being of national interest</li>
      </ul>
      <p>You also need to meet the general conditions for any Portuguese residence permit, including:</p>
      <ul>
        <li>A valid residence visa, or legal entry and stay in Portugal</li>
        <li>Enough money to support yourself</li>
        <li>Somewhere to live</li>
        <li>No serious criminal record</li>
        <li>No entry ban in Portugal or the Schengen area</li>
      </ul>
      <p class="action-line"><Button href="/portugal-hqa-visa-investment" variant="text">How the investment package fits this legal structure</Button></p>
    </div>
</Section>

    <Section tone="cream">
<div class="measure">
      <h2>Qualifications</h2>
      <p>Portuguese law describes highly qualified activity as work that needs specialised technical skills or a matching qualification. The Tech Visa programme (Portaria 328/2018) looks for an ISCED 2011 level 6 qualification, or level 5 with five years' experience in specialised technical functions. Education is one of several conditions. The official description is on the <a href="https://www.iapmei.pt/en/Paginas/Tech-Visa.aspx">IAPMEI Tech Visa page</a>.</p>
      <p>Investment packages usually expect a university degree and experience that fits the research project. Check the provider's exact criteria before you pay.</p>
    </div>
</Section>

    <Section tone="paper">
<div class="measure">
      <h2>What providers add on top</h2>
      <p>These are package rules, not legal rules. They differ by provider.</p>
      <ul>
        <li><strong>Solo applicants only.</strong> Some packages accept one founder per package.</li>
        <li><strong>Excluded nationalities.</strong> Some providers do not accept applicants from certain countries.</li>
        <li><strong>Degree and experience.</strong> Most ask for a degree and relevant work history.</li>
        <li><strong>Source of funds.</strong> All reputable providers will ask where your money comes from.</li>
        <li><strong>Family members.</strong> Usually allowed for an extra fee per person.</li>
      </ul>
      <p>Ask the provider to put every eligibility rule in writing, and to say which ones come from the law and which come from them.</p>
    </div>
</Section>

    <Section tone="cream">
<div class="measure">
<h2>Documents you will usually need</h2>
      </div>
<div class="wide">
<Table>
        <table>
          <thead>
            <tr>
              <th>Document</th>
              <th>Notes</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Valid passport</td>
              <td>Valid well beyond your planned stay</td>
            </tr>
            <tr>
              <td>Proof of qualifications</td>
              <td>Degree certificates, often apostilled and translated</td>
            </tr>
            <tr>
              <td>Contract or statement for the highly qualified role</td>
              <td>Comes from the company or institution</td>
            </tr>
            <tr>
              <td>Criminal record certificates</td>
              <td>From your country of nationality and countries where you lived</td>
            </tr>
            <tr>
              <td>Proof of means of subsistence</td>
              <td>Bank statements</td>
            </tr>
            <tr>
              <td>Proof of accommodation in Portugal</td>
              <td>Lease, property deed or similar</td>
            </tr>
            <tr>
              <td>Health insurance</td>
              <td>Valid in Portugal</td>
            </tr>
            <tr>
              <td>Portuguese tax number (NIF)</td>
              <td>Usually arranged by the provider or your lawyer</td>
            </tr>
          </tbody>
        </table>
      </Table>
      </div>
<div class="measure">
<p>Consulates publish their own checklists, and they differ by country. Use the checklist for the consulate where you will apply.</p>
    </div>
</Section>

    <Section tone="paper">
<div class="measure">
      <h2>Who this route suits</h2>
      <ul>
        <li>Founders, researchers and senior specialists with a concrete project to build in Portugal</li>
        <li>People who can meet the absence limits on a temporary permit</li>
        <li>Investors who accept that the money is at risk in a business</li>
      </ul>
      <p>It is likely the wrong route if you want residence with very little time in Portugal. The Golden Visa asks for 7 days in the first year and 14 days after that.</p>
      <p class="action-line"><Button href="/portugal-hqa-vs-golden-visa" variant="text">Portugal HQA vs Golden Visa</Button></p>
      <p class="action-line"><Button href="/guides/hqa-visa-presence-requirements" variant="text">Presence rules</Button></p>
    </div>
</Section>

    <Section tone="cream">
<div class="measure">
      <UnknownsBox level={2}>
        <p><strong>Salary thresholds.</strong> Portuguese law sets salary floors for some highly qualified routes, linked to the national average salary or to the social support index (IAS, €537.13 a month in 2026). We have not confirmed which threshold, if any, applies when you hold a role in a company funded by your own package.</p>
        <p><strong>The legal article your file uses.</strong> Some packages may file under article 90, others under article 89 (StartUP Visa). The answer changes the <a href="/hqa-visa-family">family rules</a>.</p>
        <p><strong>A founder employing themselves.</strong> Whether a founder can meet the highly qualified activity conditions through a contract with a company they control is a question for a Portuguese lawyer.</p>
      </UnknownsBox>
    </div>
</Section>
  </div>

  <LeadMagnetBand
    heading="Check your eligibility questions before you sign"
    paragraph="Our free HQA due diligence checklist includes the eligibility questions to ask any provider."
  >
    <ChecklistForm idPrefix="requirements-checklist" />
  </LeadMagnetBand>

  <div class="reading end">
    <Section tone="paper">
<div class="measure"><h2>Frequently asked questions</h2>
      <FAQ items={faqItems} />
    
</div>
</Section>

    <Section tone="cream">
<div class="measure">
      <h2>Disclaimer</h2>
      <p>This page gives general information, not legal, tax or investment advice. Requirements change and differ by consulate. Speak to a qualified Portuguese lawyer before you apply.</p>
    </div>
</Section>
  </div>
</BaseLayout>
