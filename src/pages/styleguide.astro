---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageIntro from "../components/PageIntro.astro";
import PageHero from "../components/PageHero.astro";
import KeyFacts from "../components/KeyFacts.astro";
import SourceNote from "../components/SourceNote.astro";
import UnknownsBox from "../components/UnknownsBox.astro";
import Table from "../components/Table.astro";
import FAQ from "../components/FAQ.astro";
import LeadMagnetBand from "../components/LeadMagnetBand.astro";
import GuideList from "../components/GuideList.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import Button from "../components/Button.astro";
import ChecklistForm from "../components/ChecklistForm.astro";
import ConsultationForm from "../components/ConsultationForm.astro";
import { facts, lastVerified } from "../data/facts";
import { formatVerifiedDate } from "../lib/format-date";
import hero from "../assets/images/lisbon-alfama-rooftops.webp";
import Section from "../components/Section.astro";
import Logo from "../components/Logo.astro";
import { menuLinks, reportsReady } from "../data/menu";
import { siteConfig } from "../data/site";

const description = `This page shows the shared components for Portugal HQA Citizenship. Figures come from the fact file last verified on ${formatVerifiedDate(lastVerified)}.`;

const keyFacts = [
  { lead: "Legal minimum investment.", text: facts.legalMinimumInvestment.value },
  { lead: "Reported package price.", text: facts.packagePriceReported.value },
  { lead: "Permit validity.", text: facts.permitValidity.value },
  { lead: "Citizenship.", text: facts.citizenshipYears.value },
];

const tableRows = [
  facts.legalMinimumInvestment,
  facts.packagePriceReported,
  facts.permitValidity,
  facts.citizenshipYears,
];

const tableLabels = [
  "Legal minimum investment",
  "Reported package price",
  "Permit validity",
  "Citizenship",
];

const faqItems = [
  {
    question:
      "Does Portuguese law set a minimum investment for the highly qualified activity route?",
    answer: facts.legalMinimumInvestment.value,
  },
  {
    question: "How long is the residence permit valid?",
    answer: facts.permitValidity.value,
  },
  {
    question: "How many years of legal residence does the nationality law require?",
    answer: facts.citizenshipYears.value,
  },
];

const guides = [
  {
    href: "/guides/what-is-hqa-visa",
    title: "What is the HQA visa?",
    summary: "The legal basis in plain English.",
    verified: lastVerified,
  },
  {
    href: "/guides/hqa-visa-citizenship-10-year-rule",
    title: "HQA visa citizenship under the 10-year rule",
    summary: facts.citizenshipYears.value,
    verified: lastVerified,
  },
  {
    href: "/guides/hqa-visa-presence-requirements",
    title: "HQA visa presence rules",
    summary: facts.absenceLimit.value,
    verified: lastVerified,
  },
  {
    href: "/guides/hqa-visa-ifici-tax",
    title: "HQA visa and IFICI tax",
    summary: facts.ificiRate.value,
    verified: lastVerified,
  },
];
---

<BaseLayout
  title="Component Styleguide"
  metaTitle="Component Styleguide | Portugal HQA Citizenship"
  description={description}
  canonicalPath="/styleguide"
  dateModified={lastVerified}
  noindex={true}
  schema={[
    {
      "@type": "WebPage",
      name: "Component Styleguide",
      description,
      url: "https://portugalhqacitizenship.com/styleguide",
    },
  ]}
>
  <PageIntro title="Component Styleguide" verified={lastVerified} path="/styleguide">
    <p class="lead" slot="lead">{description}</p>
  </PageIntro>

  <Section tone="cream" as="div">
    <div class="wide">
      <KeyFacts items={keyFacts} />
    </div>
  </Section>

  <Section tone="paper">
    <div class="measure">
      <h2>Header</h2>
      <p>The logo is the PH mark with PORTUGAL and HQA CITIZENSHIP. One Menu button sits on the right at every screen size and opens a full-screen cream menu. Reports and Press join the list when those pages exist.</p>
      <p><Logo /></p>
      <div class="logo-dark">
        <Logo tone="white" />
      </div>
      <p>Favicon sizes, from the same mark.</p>
      <p class="favicon-row">
        <img src="/favicon.svg" alt="Favicon" width="32" height="32" />
        <img src="/apple-touch-icon.png" alt="Apple touch icon" width="180" height="180" />
      </p>
    </div>
    <div class="menu-sample">
      <div class="sample-bar">
        <span class="sample-logo"><Logo /></span>
        <span class="sample-close">
          <svg viewBox="0 0 28 20" width="28" height="20" aria-hidden="true" focusable="false">
            <path d="M1 1 L27 19 M27 1 L1 19" fill="none" stroke="currentColor" stroke-width="2" />
          </svg>
          Close
        </span>
      </div>
      <ul class="sample-links">
        {
          menuLinks.map((link) => (
            <li>
              <a href={link.href} class:list={[{ "is-current": link.href === "/portugal-hqa-visa-investment" }]}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="sample-actions">
        <a class="sample-consult" href="/consultation">Request a consultation</a>
        {
          reportsReady && (
            <a class="sample-reports" href="/reports">
              Read our reports
              <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true" focusable="false">
                <path d="M3 13 L13 3 M13 3 H6.5 M13 3 V9.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" />
              </svg>
            </a>
          )
        }
      </div>
      <p class="sample-mail">
        <a href={`mailto:${siteConfig.contactEmail}`}>{siteConfig.contactEmail}</a>
      </p>
    </div>
    <p class="measure sample-note">Investment shows the current-page underline. Reports and Press are in the menu, and the reports button links to the reports hub.</p>
  </Section>

  <Section tone="cream">
    <div class="measure">
      <h2>Layout</h2>
      <p>This block uses the container and the measure column. The measure column is 720px wide and starts on the container's left edge.</p>
    </div>
    <div class="measure">
      <h2>Wide column</h2>
      <p>Tables, the key facts grid and guide lists use the wide column. It is the full width of the container and starts on the same left edge.</p>
    </div>
  </Section>

  <PageHero
    title="Page Hero"
    photo={hero}
    photoAlt="Rooftops of Alfama in Lisbon with São Vicente de Fora church on the skyline"
    verified={lastVerified}
    path="/styleguide"
  >
    <p class="lead" slot="lead">From 1024px the hero is two equal columns and the photo keeps a 4 / 5 frame.</p>
    <Button slot="actions" href="#checklist">Get the due diligence checklist</Button>
  </PageHero>

    <Section tone="cream">
<div class="measure">
      <h2>Source note</h2>
      <p>
        {facts.nationalityLawInForce.value}
        <SourceNote href={facts.nationalityLawInForce.source} label="Lei Orgânica 1/2026" />
      </p>
    </div>
</Section>

    <Section tone="paper">
<div class="measure">
      <UnknownsBox>
        <p>{facts.citizenshipClockStart.value}</p>
        <SourceNote href={facts.citizenshipClockStart.source} label="Lei Orgânica 1/2026" />
      </UnknownsBox>
    </div>
    <div class="wide">
      <Table>
        <table>
          <thead>
            <tr>
              <th>Record</th>
              <th>Value</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>
            {
              tableRows.map((row, index) => (
                <tr>
                  <td>{tableLabels[index]}</td>
                  <td>{row.value}</td>
                  <td>{row.status}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </Table>
    </div>
</Section>

    <Section tone="cream">
<div class="measure">
<h2>Recorded facts</h2>
      </div>
<div class="wide">
<Table>
        <table>
          <thead>
            <tr>
              <th>Record</th>
              <th>Value</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>
            {
              tableRows.map((row, index) => (
                <tr>
                  <td>{tableLabels[index]}</td>
                  <td>{row.value}</td>
                  <td>{row.status}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </Table>
    </div>
    <div class="measure">
      <UnknownsBox>
        <p>{facts.citizenshipClockStart.value}</p>
        <SourceNote href={facts.citizenshipClockStart.source} label="Lei Orgânica 1/2026" />
      </UnknownsBox>
    </div>
</Section>

    <Section tone="paper">
<div class="measure"><h2>Frequently asked questions</h2>
      <FAQ items={faqItems} />
    
</div>
</Section>

  <div id="checklist">
    <LeadMagnetBand
      heading="Before you sign with any provider"
      paragraph="Download our free HQA due diligence checklist. It lists the 15 questions to ask a provider, the contract terms to check and the red flags we see most often."
    >
      <ChecklistForm />
    </LeadMagnetBand>
  </div>

  <Section tone="paper">
<div class="measure">
      <h2>Consultation form</h2>
      <ConsultationForm />
    </div>
</Section>

    <Section tone="cream">
<div class="measure">
<h2>Guides</h2>
      </div>
<div class="wide">
<GuideList guides={guides} />
    </div>
</Section>

    <Section tone="paper">
<div class="measure">
      <h2>Breadcrumbs</h2>
      <Breadcrumbs
        items={[
          { name: "Home", href: "/" },
          { name: "Component styleguide", href: "/styleguide" },
        ]}
      />
    </div>
</Section>

    <Section tone="cream">
<div class="measure">
      <h2>Buttons</h2>
      <div class="actions">
        <Button href="#checklist">Get the due diligence checklist</Button>
        <Button href="/portugal-hqa-visa-investment" variant="text">Read the investment guide</Button>
      </div>
</div>
    </Section>
</BaseLayout>

<style>
  .logo-dark {
    box-sizing: border-box;
    width: 100%;
    margin-top: 1.5rem;
    padding: 1.5rem;
    background: #141414;
    font-size: 21px;
    line-height: 1;
  }

  .favicon-row {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .favicon-row img {
    display: block;
  }

  .menu-sample {
    box-sizing: border-box;
    margin-top: 48px;
    padding-block: 0 32px;
    background: var(--color-cream);
    color: var(--color-ink);
  }

  .sample-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
    margin-bottom: 32px;
  }

  .sample-logo {
    display: flex;
    font-size: 21px;
    line-height: 1;
  }

  .sample-close {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 48px;
    color: var(--color-ink);
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 500;
    line-height: 1.2;
  }

  .sample-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
  }

  .sample-links a {
    display: inline-flex;
    align-items: center;
    box-sizing: border-box;
    min-height: 48px;
    color: var(--color-ink);
    font-family: var(--font-serif);
    font-size: 34px;
    font-weight: 400;
    line-height: 1.1;
    text-decoration: none;
    white-space: nowrap;
  }

  .sample-links a.is-current {
    color: var(--color-atlantic);
    text-decoration-line: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 6px;
  }

  .sample-actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    margin-top: 40px;
  }

  .sample-consult,
  .sample-reports {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    height: 60px;
    padding: 0 32px;
    border: 1px solid var(--color-atlantic);
    border-radius: 4px;
    background: var(--color-atlantic);
    color: #ffffff;
    font-family: var(--font-sans);
    font-size: 18px;
    font-weight: 500;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
  }

  .sample-consult {
    background: var(--color-atlantic);
    color: #ffffff;
  }

  .sample-reports {
    background: transparent;
    color: var(--color-atlantic);
    gap: 10px;
  }

  .sample-mail {
    margin: 24px 0 0;
    color: var(--color-graphite);
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 400;
    line-height: 1.5;
  }

  .sample-mail a {
    display: inline-flex;
    align-items: center;
    box-sizing: border-box;
    min-height: 48px;
    color: var(--color-graphite);
    font-size: inherit;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .sample-note {
    margin: 8px 0 0;
    color: var(--color-graphite);
    font-family: var(--font-sans);
    font-size: 14px;
    line-height: 1.5;
  }

  @media (min-width: 768px) {
    .sample-bar {
      height: 80px;
    }

    .sample-logo {
      font-size: 26px;
    }

    .sample-links a {
      font-size: 44px;
    }

    .sample-actions {
      flex-direction: row;
      align-items: center;
    }
  }

  @media (min-width: 1024px) {
    .sample-links a {
      font-size: 56px;
    }
  }
</style>
