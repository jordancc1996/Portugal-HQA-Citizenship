---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import PageIntro from "../components/PageIntro.astro";
import Table from "../components/Table.astro";
import { getImage } from "astro:assets";
import { siteConfig } from "../data/site";
import { verifiedOn } from "../data/pages";
import defaultHero from "../assets/images/lisbon-alfama-rooftops.webp";

const description =
  "How we verify HQA visa information: 4 source levels, Portuguese law first, clear fact labels, legal review of every page and no fees from any provider.";

const headline = "Methodology: How We Verify HQA Visa Information";
const lead =
  "How we verify HQA visa information matters as much as the information itself. Investment migration is full of out-of-date claims and sales copy. This page explains where our facts come from, how we label them, who reviews them and how we correct mistakes.";
const pageUrl = "https://portugalhqacitizenship.com/methodology";
const ogAlt = "Rooftops of Alfama in Lisbon with São Vicente de Fora church on the skyline";
const mailto = `mailto:${siteConfig.contactEmail}`;
const lastVerified = verifiedOn("/methodology");

const ogImage = await getImage({
  src: defaultHero,
  width: 1200,
  height: 630,
  fit: "cover",
  format: "jpg",
  quality: 82,
  layout: "none",
});
---

<BaseLayout
  title="How We Verify HQA Visa Information - Methodology"
  metaTitle="How We Verify HQA Visa Information - Methodology | Portugal HQA Citizenship"
  description={description}
  canonicalPath="/methodology"
  dateModified={lastVerified}
  ogImage={ogImage.src}
  ogImageAlt={ogAlt}
  ogImageWidth={Number(ogImage.attributes.width ?? 1200)}
  ogImageHeight={Number(ogImage.attributes.height ?? 630)}
  schema={[
    {
      "@type": "WebPage",
      name: headline,
      description: lead,
      url: pageUrl,
    },
  ]}
>
  <PageIntro
  title={headline}
  verified={lastVerified}
  path="/methodology"
>
  <Breadcrumbs slot="crumbs"
    items={[
        { name: "Home", href: "/" },
        { name: "Methodology", href: "/methodology" },
      ]}
  />
  <p class="lead" slot="lead">{lead}</p>
</PageIntro>

  <div class="reading end">
    <section class="container section">
<div class="measure">
      <h2>Where our facts come from</h2>
      <p>We use sources in this order:</p>
      <ol>
        <li>Portuguese law as published in the Diário da República</li>
        <li>Official government and agency sources, such as AIMA, IAPMEI, the tax authority and Portuguese consulates</li>
        <li>Established Portuguese law firms and reputable publications</li>
        <li>Provider websites, only for facts about their own products, such as prices</li>
      </ol>
      <p>We never rely on a provider's claim about the law without checking the law itself.</p>
    </div>
</section>

    <section class="container section">
<div class="measure">
<h2>How we label facts</h2>
      </div>
<div class="wide">
<Table>
        <table>
          <thead>
            <tr>
              <th>Label</th>
              <th>Meaning</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Confirmed</td>
              <td>Checked in the official legal text or an official source</td>
            </tr>
            <tr>
              <td>Current</td>
              <td>Stated by a reliable source and not contradicted</td>
            </tr>
            <tr>
              <td>Reported</td>
              <td>Stated by providers or secondary sources, not confirmed officially</td>
            </tr>
            <tr>
              <td>Not confirmed</td>
              <td>We could not verify it, so we say so</td>
            </tr>
          </tbody>
        </table>
      </Table>
      </div>
<div class="measure">
<p>Where the law is unclear, we add a "What we don't know yet" box instead of guessing.</p>
    </div>
</section>

    <section class="container section">
<div class="measure">
      <h2>Legal review</h2>
      <p>An independent Portuguese lawyer reviews every page. The lawyer is not named at their request. Each page shows the date of its last legal review. We only show a review date when a review actually took place.</p>
    </div>
</section>

    <section class="container section">
<div class="measure">
      <h2>Independence</h2>
      <p>We take no referral fees or commissions from any provider, incubator, university, law firm or advisor. If you ask us for a consultation, we may introduce you to advisors or providers, but only with your consent, and we are not paid for the introduction.</p>
    </div>
</section>

    <section class="container section">
<div class="measure">
      <h2>Dates and updates</h2>
      <p>Every page shows a "Last verified" date. We change that date only when we have checked the page again. We log law changes and page updates on our <a href="/hqa-visa-status">status page</a>.</p>
    </div>
</section>

    <section class="container section">
<div class="measure">
      <h2>Corrections</h2>
      <p>If you find an error, email <a href={mailto}>{siteConfig.contactEmail}</a> with the page and the source. We check every report and correct confirmed errors.</p>
    </div>
</section>
  </div>
</BaseLayout>
