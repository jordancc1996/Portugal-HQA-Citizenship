---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import Button from "../../components/Button.astro";
import PageHero from "../../components/PageHero.astro";
import KeyFacts from "../../components/KeyFacts.astro";
import Table from "../../components/Table.astro";
import UnknownsBox from "../../components/UnknownsBox.astro";
import LeadMagnetBand from "../../components/LeadMagnetBand.astro";
import ChecklistForm from "../../components/ChecklistForm.astro";
import FAQ from "../../components/FAQ.astro";
import { getImage } from "astro:assets";
import { verifiedOn } from "../../data/pages";
import hero from "../../assets/images/lisbon-tiled-residential-building.webp";
import Section from "../../components/Section.astro";

const lastVerified = verifiedOn("/guides/hqa-visa-permanent-residency");

const description =
  "HQA visa permanent residency in Portugal after 5 years: the requirements, the basic Portuguese test, how it differs from citizenship and when to apply.";

const headline = "HQA Visa Permanent Residency: What Changes After 5 Years";
const pageUrl = "https://portugalhqacitizenship.com/guides/hqa-visa-permanent-residency";
const heroAlt = "Tiled residential building with iron balconies in Lisbon";

const ogImage = await getImage({
  src: hero,
  width: 1200,
  height: 630,
  fit: "cover",
  format: "jpg",
  quality: 82,
  layout: "none",
});

const faqItems = [
  {
    question: "When can I get permanent residency on the HQA route?",
    answer: "After at least 5 years with a temporary residence permit, if you meet the other requirements.",
  },
  {
    question: "What level of Portuguese do I need?",
    answer: "Basic knowledge, proved with a recognised certificate, such as a CAPLE test or an A2-level Portuguese course.",
  },
  {
    question: "Does permanent residence give me Portuguese nationality?",
    answer: "No. Nationality is a separate application. Most people can apply after 10 years of legal residence (7 for EU nationals and nationals of countries where Portuguese is an official language), and residence is only one of the conditions.",
  },
  {
    question: "Do I still need my HQA company after I get permanent residence?",
    answer: "Your permanent residence does not depend on the highly qualified activity. Your investment and company are a separate matter.",
  },
  {
    question: "How long is the permanent residence card valid?",
    answer: "Permanent residence status has no fixed expiry date. The residence card must be renewed every five years, and sooner if a registered identification detail changes (article 76).",
  },
];
---

<BaseLayout
  title="HQA Visa Permanent Residency - What Changes After 5 Years"
  metaTitle="HQA Visa Permanent Residency - What Changes After 5 Years | Portugal HQA Citizenship"
  description={description}
  canonicalPath="/guides/hqa-visa-permanent-residency"
  dateModified={lastVerified}
  ogImage={ogImage.src}
  ogImageAlt={heroAlt}
  ogImageWidth={Number(ogImage.attributes.width ?? 1200)}
  ogImageHeight={Number(ogImage.attributes.height ?? 630)}
  schema={[
    {
      "@type": "WebPage",
      name: headline,
      description:
        "HQA visa permanent residency becomes possible after 5 years of temporary residence in Portugal. A permanent residence permit means you stop renewing a temporary permit every few years. It does not give you Portuguese nationality, and it does not shorten the 10-year wait for citizenship.",
      url: pageUrl,
    },
    {
      "@type": "Article",
      headline,
      dateModified: lastVerified,
    },
  ]}
>
  <PageHero
  title={headline}
  photo={hero}
  photoAlt={heroAlt}
  verified={lastVerified}
  path="/guides/hqa-visa-permanent-residency"
  maxWidth={960}
  priority
>
  <Breadcrumbs slot="crumbs"
    items={[
        { name: "Home", href: "/" },
        { name: "Guides", href: "/guides" },
        { name: "HQA visa permanent residency", href: "/guides/hqa-visa-permanent-residency" },
      ]}
  />
  <p class="lead" slot="lead">
      HQA visa permanent residency becomes possible after 5 years of temporary residence in Portugal. A permanent residence permit means you stop renewing a temporary permit every few years. It does not give you Portuguese nationality, and it does not shorten the 10-year wait for citizenship.
    </p>
  <p class="small disclaimer" slot="disclaimer">This page is general information, not legal advice.</p>
</PageHero>

  <Section tone="cream" as="div">
<div class="wide">
<KeyFacts
      items={[
        {
          lead: "After 5 years.",
          text: "You need at least 5 years with a temporary residence permit.",
        },
        {
          lead: "Basic Portuguese.",
          text: "You must prove basic knowledge of the language.",
        },
        {
          lead: "No fixed expiry date.",
          text: "Permanent residence status has no fixed expiry date. The residence card must be renewed every five years, and sooner if a registered identification detail changes (article 76).",
        },
        {
          lead: "Not citizenship.",
          text: "Most people still need 10 years of legal residence before they can apply for Portuguese nationality.",
        },
      ]}
    />
    </div>
<div class="measure">
<p class="sources">Source: Lei 23/2007, articles 76 and 80.</p>
</div>
</Section>

  <div class="reading">
    <Section tone="paper">
<div class="measure">
<h2>Requirements</h2>
      </div>
<div class="wide">
<Table>
        <table>
          <thead>
            <tr>
              <th>Requirement</th>
              <th>What it means</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>5 years of temporary residence</td>
              <td>Held a temporary residence permit for at least 5 years</td>
            </tr>
            <tr>
              <td>Means of support</td>
              <td>Stable income for you and your family, without welfare</td>
            </tr>
            <tr>
              <td>Accommodation</td>
              <td>Proof of where you live</td>
            </tr>
            <tr>
              <td>Clean record</td>
              <td>No sentence or sentences adding up to more than 1 year in prison in the last 5 years</td>
            </tr>
            <tr>
              <td>Tax and social security</td>
              <td>Up to date with your obligations in Portugal</td>
            </tr>
            <tr>
              <td>Basic Portuguese</td>
              <td>A certificate such as a CAPLE test or an A2-level course</td>
            </tr>
          </tbody>
        </table>
      </Table>
    </div>
</Section>

    <Section tone="cream">
<div class="measure">
<h2>Permanent residence or citizenship?</h2>
      </div>
<div class="wide">
<Table>
        <table>
          <thead>
            <tr>
              <th></th>
              <th>Permanent residence</th>
              <th>Citizenship</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row">When</th>
              <td>After 5 years</td>
              <td>After 10 years (7 for EU nationals and nationals of countries where Portuguese is an official language)</td>
            </tr>
            <tr>
              <th scope="row">What you get</th>
              <td>Permanent residence status has no fixed expiry date. The residence card must be renewed every five years, and sooner if a registered identification detail changes (article 76).</td>
              <td>Portuguese nationality, which also makes you an EU citizen</td>
            </tr>
            <tr>
              <th scope="row">Language</th>
              <td>Basic Portuguese</td>
              <td>Portuguese test or certificate</td>
            </tr>
            <tr>
              <th scope="row">Renewals</th>
              <td>Every 5 years</td>
              <td>None</td>
            </tr>
            <tr>
              <th scope="row">Voting in national elections</th>
              <td>No</td>
              <td>Yes</td>
            </tr>
            <tr>
              <th scope="row">Move freely in the EU</th>
              <td>Limited</td>
              <td>Yes</td>
            </tr>
          </tbody>
        </table>
      </Table>
      </div>
<div class="measure">
<p class="action-line"><Button href="/guides/hqa-visa-citizenship-10-year-rule" variant="text">Citizenship under the 10-year rule</Button></p>
    </div>
</Section>

    <Section tone="paper">
<div class="measure">
      <h2>Why HQA holders may want permanent residence</h2>
      <ul>
        <li><strong>You no longer depend on the company.</strong> A temporary HQA permit depends on your highly qualified activity. Permanent residence does not.</li>
        <li><strong>Fewer renewals.</strong> One card every 5 years.</li>
        <li><strong>A bridge to citizenship.</strong> It keeps you legally resident while you build up to 10 years.</li>
      </ul>
      <div class="unknowns">
        <UnknownsBox level={3}>
          <p>Whether the new citizenship rules will change how years on a permanent residence card are counted. The law counts legal residence under any valid permit, and we expect permanent residence to count. We will confirm this when the government publishes its implementing rules.</p>
        </UnknownsBox>
      </div>
    </div>
</Section>
  </div>

  <LeadMagnetBand
    heading="Plan your long-term path"
    paragraph="Our free HQA due diligence checklist includes the long-term residence questions to ask a provider."
  >
    <ChecklistForm idPrefix="residency-checklist" />
  </LeadMagnetBand>

  <div class="reading end">
    <Section tone="paper">
<div class="measure"><h2>Frequently asked questions</h2>
      <FAQ items={faqItems} />
    
</div>
</Section>

    <Section tone="cream">
<div class="measure">
      <h2>Disclaimer</h2>
      <p>This page gives general information, not legal advice. Speak to a qualified Portuguese lawyer before you apply.</p>
    </div>
</Section>
  </div>
</BaseLayout>
