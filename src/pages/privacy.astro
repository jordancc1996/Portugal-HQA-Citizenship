---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageIntro from "../components/PageIntro.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import Table from "../components/Table.astro";
import { getImage } from "astro:assets";
import { siteConfig } from "../data/site";
import { verifiedOn } from "../data/pages";
import { isNoindex } from "../data/reviews";
import defaultHero from "../assets/images/lisbon-alfama-rooftops.webp";
import Section from "../components/Section.astro";

const description =
  "How Portugal HQA Citizenship collects, uses, shares and protects the personal data you send through our forms, and how to exercise your rights.";

const headline = "Privacy Policy";
const lead =
  'This policy explains how Portugal HQA Citizenship ("we") collects and uses personal data sent through this website. Last updated: 21 October 2026.';
const pageUrl = "https://portugalhqacitizenship.com/privacy";
const ogAlt = "Rooftops of Alfama in Lisbon with São Vicente de Fora church on the skyline";
const privacyMailto = `mailto:${siteConfig.privacyEmail}`;
const lastVerified = verifiedOn("/privacy");

const ogImage = await getImage({
  src: defaultHero,
  width: 1200,
  height: 630,
  fit: "cover",
  format: "jpg",
  quality: 82,
  layout: "none",
});
---

<BaseLayout
  title="Privacy Policy"
  metaTitle="Privacy Policy | Portugal HQA Citizenship"
  description={description}
  canonicalPath="/privacy"
  dateModified={lastVerified}
  noindex={isNoindex("/privacy")}
  ogImage={ogImage.src}
  ogImageAlt={ogAlt}
  ogImageWidth={Number(ogImage.attributes.width ?? 1200)}
  ogImageHeight={Number(ogImage.attributes.height ?? 630)}
  schema={[
    {
      "@type": "WebPage",
      name: headline,
      description: lead,
      url: pageUrl,
    },
  ]}
>
  <PageIntro
  title={headline}
>
  <Breadcrumbs slot="crumbs"
    items={[
        { name: "Home", href: "/" },
        { name: "Privacy", href: "/privacy" },
      ]}
  />
  <p class="lead" slot="lead">{lead}</p>
</PageIntro>

  <div class="reading end">
    <Section tone="cream">
<div class="measure">
      <h2>Who we are</h2>
      <p>Portugal HQA Citizenship operates this website. Contact for privacy questions and requests: <a href={privacyMailto}>{siteConfig.privacyEmail}</a>.</p>
    </div>
</Section>

    <Section tone="paper">
<div class="measure">
<h2>What we collect</h2>
      </div>
<div class="wide">
<Table>
        <table>
          <thead>
            <tr>
              <th>Form</th>
              <th>Data</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Due diligence checklist</td>
              <td>Name, email, your consent choices</td>
            </tr>
            <tr>
              <td>Consultation request</td>
              <td>First and last name, email, phone (optional), LinkedIn profile URL, country of citizenship, planned timing, message (optional), your consent choices</td>
            </tr>
          </tbody>
        </table>
      </Table>
      </div>
<div class="measure">
<p>We do not ask for passport numbers, financial account details or documents.</p>
    </div>
</Section>

    <Section tone="cream">
<div class="measure">
      <h2>Why we use it</h2>
      <ul>
        <li>When you request the checklist, we use your name and email to process the request, and the page then shows a link to the checklist. We do not email it.</li>
        <li>To reply to your consultation request</li>
        <li>To introduce you to advisors or providers, only if you tick the sharing box</li>
        <li>To email you about rule changes, only if you tick the updates box</li>
      </ul>
      <p>We use your data on the basis of your consent. You can withdraw consent at any time.</p>
    </div>
</Section>

    <Section tone="paper">
<div class="measure">
      <h2>Who we share it with</h2>
      <ul>
        <li>We share a consultation request only with the advisor or provider you asked to be introduced to, and only if you ticked the sharing box. We do not sell your data.</li>
        <li>Formcarry receives the form submissions and Vercel hosts the website. They process this data on our instructions under their data processing terms.</li>
      </ul>
    </div>
</Section>

    <Section tone="cream">
<div class="measure">
      <h2>Transfers outside Europe</h2>
      <p>Formcarry and Vercel are companies based in the United States. Formcarry stores submissions in the European Union, but some of its service providers, including email delivery and spam filtering, are in the United States. Vercel may process your IP address in the United States. Both companies' data processing terms include the EU Standard Contractual Clauses, and Vercel is also certified under the EU-U.S. Data Privacy Framework.</p>
    </div>
</Section>

    <Section tone="paper">
<div class="measure">
      <h2>How long we keep it</h2>
      <p>Checklist requests: deleted within 30 days, unless you asked for update emails. Consultation requests: kept while we arrange the introduction you asked for, then deleted within 6 months. Update emails: kept until you unsubscribe, and reviewed after 24 months without activity.</p>
    </div>
</Section>

    <Section tone="cream">
<div class="measure">
      <h2>Your rights</h2>
      <p>You can ask to access, correct or delete your data, to restrict or object to its use, or to receive a copy of it. You can withdraw consent at any time. Email <a href={privacyMailto}>{siteConfig.privacyEmail}</a>.</p>
      <p>You can also complain to the Portuguese data protection authority, the Comissão Nacional de Proteção de Dados (CNPD).</p>
    </div>
</Section>

    <Section tone="paper">
<div class="measure">
      <h2>Cookies and analytics</h2>
      <p>This site does not use analytics or advertising cookies.</p>
    </div>
</Section>

    <Section tone="cream">
<div class="measure">
      <h2>Changes</h2>
      <p>We will post any changes to this policy on this page with a new date.</p>
    </div>
</Section>
  </div>
</BaseLayout>
